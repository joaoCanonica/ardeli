---
// Rotas internas que começam com "_" (o Astro ignora arquivos com "_" em src/pages).
// Sempre noindex.
import PaginaCapa from '../components/capa/PaginaCapa.astro';
import Estilo from './_estilo.astro';

export function getStaticPaths() {
  return [
    { params: { interna: '_estilo' }, props: { pagina: 'estilo' } },
    { params: { interna: '_capa-a' }, props: { pagina: 'capa-a' } },
    { params: { interna: '_capa-b' }, props: { pagina: 'capa-b' } },
  ];
}
const { pagina } = Astro.props as { pagina: 'estilo' | 'capa-a' | 'capa-b' };
---

{pagina === 'estilo' && <Estilo />}
{pagina === 'capa-a' && <PaginaCapa variante="a" titulo="Capa A · Ardeli (comparação)" noindex />}
{pagina === 'capa-b' && <PaginaCapa variante="b" titulo="Capa B · Ardeli (comparação)" noindex />}
