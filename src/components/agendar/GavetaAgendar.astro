---
// Gaveta do agendador: <dialog> nativo (foco preso, Esc fecha, fundo inerte).
// Abre a partir de qualquer link com data-agendar (data-forma, data-motivo, data-origem).
// Sem JS, esses links continuam sendo links diretos para o WhatsApp (mensagem geral).
import { agendador as t } from '../../content/textos/agendador.ts';
import Icone from '../base/Icone.astro';
import Agendador from './Agendador.astro';
---

<dialog class="gaveta" data-gaveta aria-labelledby="gaveta-titulo">
  <div class="gaveta__topo">
    <p class="gaveta__titulo" id="gaveta-titulo">
      {t.titulo}
    </p>
    <button type="button" class="gaveta__fechar" data-gaveta-fechar>
      <Icone nome="fechar" tamanho="1.6rem" />
      <span class="visualmente-oculto">{t.fechar}</span>
    </button>
  </div>
  <div class="gaveta__corpo">
    <Agendador prefixo="gaveta" />
  </div>
</dialog>

<script>
  import { iniciarGaveta } from './gaveta.ts';
  iniciarGaveta();
</script>

<style>
  .gaveta {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--fundo-cartao);
    color: var(--texto);
    overscroll-behavior: contain;
  }
  .gaveta::backdrop {
    background: rgb(18 48 72 / 0.55);
  }
  .gaveta[open] {
    display: flex;
    flex-direction: column;
    animation: gaveta-entra var(--duracao-media) var(--curva);
  }
  .gaveta__topo {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3);
    padding: var(--e-2) var(--margem);
    background: var(--fundo-cartao);
    border-bottom: var(--fio-fino) solid var(--fio);
  }
  .gaveta__titulo {
    margin: 0;
    font-family: var(--fonte-serifa);
    font-size: min(var(--titulo-3), 9vw);
    color: var(--texto-forte);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .gaveta__fechar {
    flex: none;
    display: inline-grid;
    place-items: center;
    min-width: var(--botao-altura);
    min-height: var(--botao-altura);
    border: 2px solid var(--cor-marinho);
    border-radius: var(--raio-botao);
    background: transparent;
    color: var(--cor-marinho);
    cursor: pointer;
  }
  .gaveta__corpo {
    flex: 1;
    overflow-y: auto;
    padding: var(--e-5) var(--margem) var(--e-7);
  }
  @media (min-width: 48rem) {
    .gaveta {
      width: min(36rem, 100%);
      margin-left: auto;
      margin-right: 0;
      border-left: 2px solid var(--cor-marinho);
    }
  }
  @keyframes gaveta-entra {
    from {
      transform: translateY(1.5rem);
      opacity: 0;
    }
  }
  @media (min-width: 48rem) {
    @keyframes gaveta-entra {
      from {
        transform: translateX(2rem);
        opacity: 0;
      }
    }
  }
</style>
