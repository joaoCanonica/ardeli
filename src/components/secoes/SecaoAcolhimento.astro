---
// ACOLHIMENTO / QUEM CUIDA (Linho). Gesto: os dois cartões lado a lado, com o Art. 48
// em cada um, e o fato verificável da trajetória (sem link ao Studio Ar até o João aprovar).
import { profissionais } from '../../content/dados/profissionais.ts';
import { acolhimento } from '../../content/textos/home.ts';
import { textos } from '../../content/textos/tipos.ts';
import CartaoProfissional from '../base/CartaoProfissional.astro';
import Link from '../base/Link.astro';
import Verbete from '../verbete/Verbete.astro';
import Secao from './Secao.astro';

const ordem = [...profissionais].sort((a, b) => a.ordem - b.ordem);
---

<Secao id="quem-cuida">
  <Verbete
    palavra={acolhimento.verbete.palavra}
    classe={acolhimento.verbete.classe}
    acepcoes={textos(acolhimento.verbete.acepcoes)}
    id="verbete-acolhimento"
  />
  <div class="cartoes">
    {ordem.map((p) => (
      <CartaoProfissional profissional={p} />
    ))}
  </div>
  <p class="fato">
    <span class="fato__marca" aria-hidden="true"></span>
    <span class="fato__texto">{acolhimento.fato.texto}</span>
  </p>
  <p>
    <Link href="/quem-cuida">{acolhimento.chamada.texto}</Link>
  </p>
</Secao>

<style>
  .cartoes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--e-5);
    margin: var(--e-6) 0 var(--e-5);
  }
  .fato {
    display: flex;
    align-items: baseline;
    gap: var(--e-3);
    font-family: var(--fonte-serifa);
    font-size: var(--titulo-3);
    color: var(--texto-forte);
    line-height: 1.3;
  }
  .fato__texto {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .fato__marca {
    flex: none;
    width: 2rem;
    border-top: 2px solid var(--cor-salvia);
    transform: translateY(-0.3em);
  }
</style>
