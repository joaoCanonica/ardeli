---
// Ícones próprios, traço de 1,75 em grade de 24px. Decorativos por padrão
// (o texto do botão/link já diz o que é). Nada de ícone de coluna, esqueleto
// ou estetoscópio (CLAUDE.md §8).
export type NomeIcone =
  | 'whatsapp'
  | 'telefone'
  | 'mapa'
  | 'relogio'
  | 'info'
  | 'atencao'
  | 'seta'
  | 'play'
  | 'pausa'
  | 'menu'
  | 'fechar'
  | 'convenio';
interface Props {
  nome: NomeIcone;
  tamanho?: string;
  rotulo?: string;
  class?: string;
}
const { nome, tamanho = '1.5em', rotulo, class: classe } = Astro.props;

// WhatsApp: balão com telefone, desenhado aqui (não é o logo oficial).
const caminhos: Record<NomeIcone, string> = {
  whatsapp:
    '<path d="M12 3.2a8.8 8.8 0 0 0-7.6 13.3L3.3 20.7l4.3-1.1A8.8 8.8 0 1 0 12 3.2Z"/><path d="M9.1 7.9c-.4 0-.8.3-.9.7-.3 1.4.2 3 1.6 4.6 1.5 1.6 3.2 2.4 4.6 2.2.4 0 .7-.4.8-.8l.2-.9c.1-.3-.1-.6-.4-.7l-1.6-.7c-.3-.1-.6 0-.8.2l-.5.6a5 5 0 0 1-2.4-2.3l.5-.6c.2-.2.3-.5.2-.8l-.6-1.7c-.1-.3-.4-.5-.7-.5Z"/>',
  telefone:
    '<path d="M6.6 3.5h-2a1.2 1.2 0 0 0-1.2 1.3c.5 8.1 7.1 14.7 15.2 15.2a1.2 1.2 0 0 0 1.3-1.2v-2c0-.6-.4-1.1-1-1.2l-3.2-.6c-.4-.1-.9.1-1.1.4l-1.3 1.7a12.6 12.6 0 0 1-5.6-5.6l1.7-1.3c.3-.2.5-.7.4-1.1L9.1 5.9c-.1-.6-.6-1-1.2-1Z"/>',
  mapa: '<path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.8" r="2.4"/>',
  relogio: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  info: '<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5"/><path d="M12 7.6v.1"/>',
  atencao: '<path d="M12 3.8 2.9 19.5h18.2L12 3.8Z"/><path d="M12 10v4.2"/><path d="M12 17v.1"/>',
  seta: '<path d="M5 12h13.5"/><path d="m13 6.5 5.5 5.5-5.5 5.5"/>',
  play: '<circle cx="12" cy="12" r="8.5"/><path d="m10.2 8.8 5 3.2-5 3.2Z"/>',
  pausa: '<circle cx="12" cy="12" r="8.5"/><path d="M10 9v6"/><path d="M14 9v6"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  fechar: '<path d="m6 6 12 12"/><path d="M18 6 6 18"/>',
  convenio:
    '<rect x="3.5" y="6" width="17" height="12" rx="2"/><path d="M3.5 10h17"/><path d="M7 14.5h4"/>',
};
---

<svg
  class:list={['icone', classe]}
  viewBox="0 0 24 24"
  width={tamanho}
  height={tamanho}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={rotulo ? 'img' : undefined}
  aria-label={rotulo}
  aria-hidden={rotulo ? undefined : 'true'}
  focusable="false"
  set:html={caminhos[nome]}
/>

<style>
  .icone {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
