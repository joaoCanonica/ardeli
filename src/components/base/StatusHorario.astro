---
// "Aberto agora · até 20h" / "Fecha em 30 min" / "Fechado · abre segunda às 8h".
// Calculado no aparelho (fuso de Lages, feriados). Sem JS: horário por extenso.
import { configHorario, horarioPorExtenso } from '../../lib/horario.ts';
import Icone from './Icone.astro';

interface Props {
  class?: string;
}
const ano = new Date().getFullYear();
const config = JSON.stringify(configHorario([ano, ano + 1]));
---

<p class:list={['status', Astro.props.class]} data-config-horario={config}>
  <Icone nome="relogio" tamanho="1.3rem" />
  <span>
    <span class="status__vivo" data-status-horario hidden>
      <span class="status__ponto" aria-hidden="true"></span>
      <strong data-status-texto></strong>
      <span class="status__sep" aria-hidden="true">
        {' '}
        ·{' '}
      </span>
    </span>
    <span class="status__fixo num">{horarioPorExtenso()}</span>
  </span>
</p>

<script>
  import { iniciarHorario } from '../../scripts/horario.ts';
  iniciarHorario();
</script>

<style>
  .status {
    display: flex;
    align-items: baseline;
    gap: var(--e-2);
    margin: 0;
    max-width: none;
  }
  .status :global(.icone) {
    align-self: center;
    color: var(--texto-forte);
  }
  .status__vivo[hidden] {
    display: none;
  }
  .status__ponto {
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    margin-right: 0.4em;
    border-radius: 50%;
    border: 2px solid currentColor;
    vertical-align: 0.05em;
  }
  /* Estado não depende só da cor: o texto diz "Aberto"/"Fechado". */
  [data-estado='aberto'] .status__ponto {
    background: var(--cor-salvia);
    border-color: var(--cor-salvia-escura);
  }
  .status strong {
    color: var(--texto-forte);
  }
</style>
